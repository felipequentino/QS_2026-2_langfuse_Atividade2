# Copie para .env e preencha. O .env nunca deve ser versionado.
LLM_PROVIDER=groq                 # groq (padrão) ou gemini
GROQ_API_KEY=gsk_...              # https://console.groq.com/keys
LLM_MODEL=openai/gpt-oss-120b     # para gemini: gemini-3.8-flash
LLM_TEMPERATURE=0
GEMINI_API_KEY=                   # opcional (free tier: 20 req/dia por modelo)
RAG_TOP_K=4

# Langfuse Cloud (https://cloud.langfuse.com ou https://us.cloud.langfuse.com) ou self-host
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
